# Infrastructure-only configuration. Everything else (brand, theme, shipping,
# payment rules, messages, integrations, AI providers, staff...) is configured
# from the admin panel and stored in the `settings` table. See docs/PROJECT_SPEC.md 4.1.

NODE_ENV=development
LOG_LEVEL=debug

# free | vps — see docs/PROJECT_SPEC.md 15.2 / 15.3
HOSTING_TIER=free
# embedded | separate — embedded runs the job worker inside the API process (free tier)
WORKER_MODE=embedded

# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clothing_ecommerce?schema=public"
DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/clothing_ecommerce?schema=public"

# --- App URLs (used for CORS, cookies, links in messages, CSP) ---
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# --- Secrets ---
# 32-byte key (base64) used for AES-256-GCM encryption of secret settings and provider credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Shared secret the API checks when the storefront's /api/revalidate endpoint is called.
REVALIDATE_SECRET=

# Shared secret required on /api/v1/public/cron/:task (external cron trigger on free tier).
CRON_SECRET=

# --- File storage (StorageProvider) ---
# local | s3
STORAGE_DRIVER=local
# Only used when STORAGE_DRIVER=local.
STORAGE_LOCAL_ROOT=./.data/media
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Optional: Redis (CacheService + BullMQ driver). Unset = in-memory cache + pg-boss queue. ---
REDIS_URL=

# --- Optional: Meilisearch (SearchProvider). Unset = Postgres full-text + trigram. ---
MEILI_URL=
MEILI_KEY=

# --- Optional: Sentry ---
SENTRY_DSN=
