{
  "name": "clothing-ecommerce",
  "private": true,
  "version": "0.1.0",
  "description": "White-label, production-grade e-commerce platform for clothing brands in Bangladesh.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:storefront": "turbo run dev --filter=storefront",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @clothing/db generate",
    "db:migrate": "pnpm --filter @clothing/db migrate",
    "db:migrate:deploy": "pnpm --filter @clothing/db migrate:deploy",
    "db:seed": "pnpm --filter @clothing/db seed",
    "db:seed:demo": "pnpm --filter @clothing/db seed:demo",
    "sdk:generate": "pnpm --filter @clothing/sdk generate",
    "e2e": "pnpm --filter e2e test"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "rimraf": "6.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
