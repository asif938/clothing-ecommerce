{
  "name": "@clothing/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-app zod schemas, types, enums, money/phone/date utils, permission list, settings registry.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./settings": "./src/settings/index.ts",
    "./permissions": "./src/permissions/index.ts",
    "./crypto": "./src/crypto/index.ts",
    "./providers": "./src/providers/index.ts",
    "./media": "./src/media/url.ts",
    "./notifications": "./src/notifications/index.ts",
    "./automation": "./src/automation/index.ts",
    "./marketing": "./src/marketing/index.ts",
    "./ai": "./src/ai/index.ts",
    "./personalization": "./src/personalization/index.ts",
    "./support": "./src/support/index.ts",
    "./rewards": "./src/rewards/index.ts",
    "./analytics": "./src/analytics/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@node-rs/argon2": "2.2.2",
    "nodemailer": "10.2.0",
    "otplib": "13.5.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@clothing/config": "workspace:*",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
