  status                    OrderStatus        @default(pending_payment)
  paymentStatus             OrderPaymentStatus @default(unpaid) @map("payment_status")
  fulfillmentStatus         FulfillmentStatus  @default(unfulfilled) @map("fulfillment_status")
  currency                  String             @default("BDT")
  subtotal                  Int
  discountTotal             Int                @default(0) @map("discount_total")
  shippingFee               Int                @default(0) @map("shipping_fee")
  shippingDiscount          Int                @default(0) @map("shipping_discount")
  advanceRequired           Int                @default(0) @map("advance_required")
  advancePaid               Int                @default(0) @map("advance_paid")
  codAmount                 Int                @default(0) @map("cod_amount")
  total                     Int
  paidTotal                 Int                @default(0) @map("paid_total")
  refundedTotal             Int                @default(0) @map("refunded_total")
  shippingAddress           Json               @map("shipping_address")
  billingContact            Json               @map("billing_contact")
  customerNote              String?            @map("customer_note")
  riskScore                 Int                @default(0) @map("risk_score")
  riskReasonCodes           String[]           @default([]) @map("risk_reason_codes")
  riskLevel                 RiskLevel          @default(low) @map("risk_level")
  requiresReview            Boolean            @default(false) @map("requires_review")
  assignedTo                String?            @map("assigned_to")
  confirmedBy               String?            @map("confirmed_by")
  confirmedAt               DateTime?          @map("confirmed_at")
  cancelledReason           String?            @map("cancelled_reason")
  utmSource                 String?            @map("utm_source")
  utmMedium                 String?            @map("utm_medium")
  utmCampaign               String?            @map("utm_campaign")
  utmContent                String?            @map("utm_content")
  referrer                  String?
  landingPage               String?            @map("landing_page")
  ip                        String?
  userAgent                 String?            @map("user_agent")
  deviceId                  String?            @map("device_id")
  idempotencyKey            String?            @unique @map("idempotency_key")
  tags                      String[]           @default([])
  paymentTimeoutAt          DateTime?          @map("payment_timeout_at")
  reservationReleasedAt     DateTime?          @map("reservation_released_at")
  // §6.6 duplicate detection (RiskScoringService.findPossibleDuplicates, wired
  // up at placement in M6) — ids of other orders that look like the same
  // order placed twice; symmetric (each duplicate lists every other one).
  possibleDuplicateOrderIds String[]           @default([]) @map("possible_duplicate_order_ids")
  // Set once, the first time the order (or any of its shipments) reaches
  // delivered/partially_delivered — drives the automatic delivered→completed
  // sweep after `returns.windowDays` (§6.8) and the loyalty pendingDays clock
  // (M8/M13, not wired yet).
  deliveredAt               DateTime?          @map("delivered_at")
  // Snapshot of `CartPricingResult.totalWeightGrams` at placement (§6.3) —
  // shipment booking (M6) needs the order's total parcel weight and
  // shouldn't have to re-derive it from variant/product weight fallbacks a
  // second time.
  totalWeightGrams          Int                @default(0) @map("total_weight_grams")
  // §10.5/§13.3 (M8) — the client pixel's event id for this order's
  // Purchase event, captured at placement so the server-side CAPI/MP/
  // Events-API copy can share the same id for platform-side dedup even
  // when `tracking.purchaseEventTiming` defers the server send until
  // confirmation (which may happen long after the original request).
  trackingEventId           String?            @map("tracking_event_id")
  // §16 M11 — customer self-confirmation (SMS link / WhatsApp button).
  // `confirmationToken` is an unguessable single-order token embedded in
  // the link; cleared once used.
  confirmationToken         String?            @unique @map("confirmation_token")
  confirmationRequestedAt   DateTime?          @map("confirmation_requested_at")
  // §16 M11 merge/split — a merged-away order points at the survivor; an
  // order created by a split points at the order it was carved from.
  mergedIntoOrderId         String?            @map("merged_into_order_id")
  splitFromOrderId          String?            @map("split_from_order_id")
  // §16 M13 — loyalty redemption at checkout (§6.3 step 9): points spent and
  // the poisha they took off `total`. Kept apart from `discountTotal`, which
  // stays coupons/automatic discounts only.
  pointsRedeemed            Int                @default(0) @map("points_redeemed")
  pointsDiscount            Int                @default(0) @map("points_discount")
  // §16 M14 — the shopper's `anonymous_id` cookie at placement, so A/B test
  // conversions and revenue can be attributed to the variant they saw.
  visitorId                 String?            @map("visitor_id")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  discounts      OrderDiscount[]
  events         OrderEvent[]
  payments       Payment[]
  discountUsages DiscountUsage[]
  shipments      Shipment[]
  refunds        Refund[]
  returns        Return[]
  invoice        Invoice?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([assignedTo, status])
  @@index([visitorId])
  @@map("orders")
}

