// ---------------------------------------------------------------------------
// Milestone 6 (docs/PROJECT_SPEC.md §5.6, §6.8-§6.10, §16 M6): fulfillment.
// `OrderStatus` already carries the full §6.8 state machine (added ahead of
// time in M5, see the model above) — this milestone is what actually drives
// it: shipments/couriers, doorstep rejection & partial delivery (§6.9),
// returns & exchanges (§6.10), refunds, invoices, and courier area mapping.
// Labels/invoices print via the browser's own print-to-PDF, same as the
// M2 barcode-label screen (`apps/admin/.../inventory/page.tsx`) — no new PDF
// or barcode-image dependency, see docs/DECISIONS.md.
// ---------------------------------------------------------------------------

enum ShipmentStatus {
  pending
  booked
  picked_up
  in_transit
  out_for_delivery
  delivered
  partially_delivered
  returned_to_sender
  rejected_at_door
  cancelled
  lost
}

model Shipment {
  id                        String         @id @default(cuid(2))
  orderId                   String         @map("order_id")
  locationId                String         @map("location_id")
  courierProviderInstanceId String?        @map("courier_provider_instance_id")
  // Snapshot of which driver booked it, so the shipment stays interpretable
  // even if the provider instance is later disabled/deleted.
  courierDriver             String         @map("courier_driver")
  manual                    Boolean        @default(false)
  consignmentId             String?        @map("consignment_id")
  trackingCode              String?        @map("tracking_code")
  trackingUrl               String?        @map("tracking_url")
  status                    ShipmentStatus @default(pending)
  rawStatus                 String?        @map("raw_status")
  codAmount                 Int            @default(0) @map("cod_amount")
  weightGrams               Int            @map("weight_grams")
  // §10.2 "delivery_charge_actual (courier cost)" — what the courier billed us.
  deliveryChargeActual      Int?           @map("delivery_charge_actual")
  // §6.9 — delivery fee the courier collected from the customer at the door
  // on a rejection/partial delivery (distinct from deliveryChargeActual,
  // which is what the courier charges *us*).
  deliveryFeeCollected      Int?           @map("delivery_fee_collected")
  bookedAt                  DateTime?      @map("booked_at")
  deliveredAt               DateTime?      @map("delivered_at")
  handedOverAt              DateTime?      @map("handed_over_at")
  // Poll fallback job (§10.2: "every 2h for active shipments") — null means
  // never polled yet.
  lastPolledAt              DateTime?      @map("last_polled_at")
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  location StockLocation   @relation(fields: [locationId], references: [id])
  items    ShipmentItem[]
  events   ShipmentEvent[]

  @@index([orderId])
  @@index([status])
  @@index([consignmentId])
  @@map("shipments")
}

/**
 * Which order items (and how many) travel in this parcel — almost always all of them, but kept separate from `OrderItem` so a future split-shipment doesn't need a schema change.
 */
model ShipmentItem {
  id          String @id @default(cuid(2))
  shipmentId  String @map("shipment_id")
  orderItemId String @map("order_item_id")
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_items")
}

model ShipmentEvent {
  id         String         @id @default(cuid(2))
  shipmentId String         @map("shipment_id")
  status     ShipmentStatus
  rawStatus  String?        @map("raw_status")
  message    String?
  occurredAt DateTime       @default(now()) @map("occurred_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

enum RefundMethod {
  original
  bkash_manual
  nagad_manual
  bank
  store_credit
}

enum RefundStatus {
  pending
  processing
  completed
  rejected
  cancelled
}

/**
 * Always created as `pending` for staff to action (§6.9/§10.1: "creates a refund record" / "refunds queue (pending manual refunds with trx id entry)") — nothing here auto-disburses money.
 */
model Refund {
  id          String       @id @default(cuid(2))
  orderId     String       @map("order_id")
