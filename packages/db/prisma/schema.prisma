  returnId    String?      @map("return_id")
  amount      Int
  method      RefundMethod
  status      RefundStatus @default(pending)
  reason      String?
  approvedBy  String?      @map("approved_by")
  externalRef String?      @map("external_ref")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  return  Return?  @relation(fields: [returnId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

enum ReturnShippingPaidBy {
  customer
  brand
}

/**
 * Admin-managed, localized reasons list (§6.10) with a per-reason default on who pays return shipping.
 */
model ReturnReason {
  id            String               @id @default(cuid(2))
  code          String               @unique
  label         Json
  defaultPaidBy ReturnShippingPaidBy @default(customer) @map("default_paid_by")
  isActive      Boolean              @default(true) @map("is_active")
  position      Int                  @default(0)

  @@map("return_reasons")
}

enum ReturnType {
  refund
  exchange
  store_credit
}

enum ReturnStatus {
  requested
  approved
  rejected
  pickup_scheduled
  received
  inspected
  completed
  cancelled
}

model Return {
  id                   String                @id @default(cuid(2))
  orderId              String                @map("order_id")
  customerId           String?               @map("customer_id")
  type                 ReturnType
  status               ReturnStatus          @default(requested)
  reasonCode           String?               @map("reason_code")
  customerComment      String?               @map("customer_comment")
  mediaIds             String[]              @default([]) @map("media_ids")
  // [{ orderItemId, quantity, condition?: "pass"|"fail", restock?: boolean }]
  // — a point-in-time snapshot of what was requested/inspected, same
  // convention as `OrderDiscount.allocation`/`Cart` snapshots rather than a
  // join table.
  items                Json
  returnShippingPaidBy ReturnShippingPaidBy? @map("return_shipping_paid_by")
  resolution           Json?
  exchangeOrderId      String?               @map("exchange_order_id")
  rejectedReason       String?               @map("rejected_reason")
  approvedBy           String?               @map("approved_by")
  approvedAt           DateTime?             @map("approved_at")
  receivedAt           DateTime?             @map("received_at")
  completedAt          DateTime?             @map("completed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  refunds  Refund[]

  @@index([orderId])
  @@index([status])
  @@map("returns")
}

/**
 * Just a number + timestamp (§5.6) — the PDF itself is rendered on demand by the admin app's print view (browser print-to-PDF), never stored; this only guarantees the number stays stable across re-prints.
 */
model Invoice {
  id          String   @id @default(cuid(2))
  orderId     String   @unique @map("order_id")
  number      String   @unique
  generatedAt DateTime @default(now()) @map("generated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

/**
 * §10.2 "area mapping tool in admin" — maps our division/district/area to a specific courier provider instance's own location codes (Pathao city/zone/area, RedX area id, …) so booking a parcel doesn't need the staff member to remember codes.
 */
model CourierAreaMapping {
  id                        String   @id @default(cuid(2))
  courierProviderInstanceId String   @map("courier_provider_instance_id")
  divisionId                String   @map("division_id")
  districtId                String   @map("district_id")
  areaId                    String?  @map("area_id")
  courierAreaCode           String   @map("courier_area_code")
  courierAreaName           String?  @map("courier_area_name")
  extra                     Json?
  createdAt                 DateTime @default(now()) @map("created_at")

  @@unique([courierProviderInstanceId, divisionId, districtId, areaId])
  @@map("courier_area_mappings")
}
