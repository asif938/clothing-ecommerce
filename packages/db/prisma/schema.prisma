enum TrackingEventLogStatus {
  queued
  sent
  failed
}

// Server-side pixel delivery log (§10.5: "Event delivery log in admin"). One
// row per (event, driver) attempt — `eventId` is the same id the client
// pixel call used for that event, so admin can confirm the acceptance
// scenario's "client and server Purchase events share one event_id"
// directly from this table. `driver` is a free-text driver key
// ("meta_capi"/"ga4_mp"/"tiktok_events"/"mock"), the same "string, not an
// enum" choice `NotificationLog.driver` already made — a tracking
// `provider_instances` row can be any of several drivers, including more
// than one testing the same conceptual platform, so there's no fixed small
// enum to constrain it to.
model TrackingEventLog {
  id                 String                 @id @default(cuid(2))
  eventId            String                 @map("event_id")
  eventName          String                 @map("event_name")
  driver             String
  providerInstanceId String?                @map("provider_instance_id")
  status             TrackingEventLogStatus @default(queued)
  attempts           Int                    @default(0)
  lastError          String?                @map("last_error")
  payload            Json
  relatedEntityType  String?                @map("related_entity_type")
  relatedEntityId    String?                @map("related_entity_id")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@index([eventId])
  @@index([status])
  @@map("tracking_event_logs")
}

enum PaymentMethod {
  cod
  mock
  sslcommerz
  bkash
  nagad
  store_credit
}

enum PaymentPurpose {
  full
  advance
  balance
}

enum PaymentStatus {
  initiated
  pending
  succeeded
  failed
  cancelled
  expired
}

model Payment {
  id                 String         @id @default(cuid(2))
  orderId            String         @map("order_id")
  providerInstanceId String?        @map("provider_instance_id")
  method             PaymentMethod
  purpose            PaymentPurpose
  amount             Int
  status             PaymentStatus  @default(initiated)
  externalRef        String?        @map("external_ref")
  raw                Json?
  paidAt             DateTime?      @map("paid_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([externalRef])
  @@map("payments")
}

enum BlocklistEntryType {
  phone
  ip
  device
  email
  address_keyword
}

/**
 * §6.5 default seeded rule 1 ("active" out of the box) + §6.6 risk signal 1 — moved here from its spec table home under §5.10 since the M5 payment-rules/risk-scoring business logic needs it now, not later.
 */
model BlocklistEntry {
  id        String             @id @default(cuid(2))
  type      BlocklistEntryType
  value     String
  reason    String?
  expiresAt DateTime?          @map("expires_at")
  createdBy String?            @map("created_by")
  createdAt DateTime           @default(now()) @map("created_at")

  @@index([type, value])
  @@map("blocklist_entries")
}

// ---------------------------------------------------------------------------
// Milestone 6 (docs/PROJECT_SPEC.md §5.6, §6.8-§6.10, §16 M6): fulfillment.
// `OrderStatus` already carries the full §6.8 state machine (added ahead of
// time in M5, see the model above) — this milestone is what actually drives
// it: shipments/couriers, doorstep rejection & partial delivery (§6.9),
// returns & exchanges (§6.10), refunds, invoices, and courier area mapping.
// Labels/invoices print via the browser's own print-to-PDF, same as the
// M2 barcode-label screen (`apps/admin/.../inventory/page.tsx`) — no new PDF
// or barcode-image dependency, see docs/DECISIONS.md.
// ---------------------------------------------------------------------------

enum ShipmentStatus {
  pending
  booked
  picked_up
  in_transit
  out_for_delivery
  delivered
  partially_delivered
  returned_to_sender
  rejected_at_door
  cancelled
  lost
}

model Shipment {
  id                        String         @id @default(cuid(2))
  orderId                   String         @map("order_id")
  locationId                String         @map("location_id")
  courierProviderInstanceId String?        @map("courier_provider_instance_id")
  // Snapshot of which driver booked it, so the shipment stays interpretable
  // even if the provider instance is later disabled/deleted.
  courierDriver             String         @map("courier_driver")
  manual                    Boolean        @default(false)
  consignmentId             String?        @map("consignment_id")
  trackingCode              String?        @map("tracking_code")
  trackingUrl               String?        @map("tracking_url")
  status                    ShipmentStatus @default(pending)
  rawStatus                 String?        @map("raw_status")
  codAmount                 Int            @default(0) @map("cod_amount")
  weightGrams               Int            @map("weight_grams")
  // §10.2 "delivery_charge_actual (courier cost)" — what the courier billed us.
  deliveryChargeActual      Int?           @map("delivery_charge_actual")
  // §6.9 — delivery fee the courier collected from the customer at the door
  // on a rejection/partial delivery (distinct from deliveryChargeActual,
  // which is what the courier charges *us*).
  deliveryFeeCollected      Int?           @map("delivery_fee_collected")
  bookedAt                  DateTime?      @map("booked_at")
  deliveredAt               DateTime?      @map("delivered_at")
  handedOverAt              DateTime?      @map("handed_over_at")
  // Poll fallback job (§10.2: "every 2h for active shipments") — null means
  // never polled yet.
  lastPolledAt              DateTime?      @map("last_polled_at")
  // §16 M12 COD reconciliation — set when a confirmed courier settlement
  // line matched this shipment; `codSettledAmount` is what the courier
  // actually remitted for it (may differ from `codAmount`, see the line's
  // variance).
  codSettledAt              DateTime?      @map("cod_settled_at")
  codSettledAmount          Int?           @map("cod_settled_amount")
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  location           StockLocation       @relation(fields: [locationId], references: [id])
  items              ShipmentItem[]
  events             ShipmentEvent[]
  codSettlementLines CodSettlementLine[]

  @@index([orderId])
  @@index([status])
  @@index([consignmentId])
  @@index([createdAt])
  @@map("shipments")
}

/**
 * Which order items (and how many) travel in this parcel — almost always all of them, but kept separate from `OrderItem` so a future split-shipment doesn't need a schema change.
 */
model ShipmentItem {
  id          String @id @default(cuid(2))
  shipmentId  String @map("shipment_id")
  orderItemId String @map("order_item_id")
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_items")
}

model ShipmentEvent {
  id         String         @id @default(cuid(2))
  shipmentId String         @map("shipment_id")
  status     ShipmentStatus
  rawStatus  String?        @map("raw_status")
  message    String?
  occurredAt DateTime       @default(now()) @map("occurred_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

enum RefundMethod {
  original
  bkash_manual
  nagad_manual
  bank
  store_credit
}

enum RefundStatus {
  pending
  processing
  completed
  rejected
  cancelled
}

/**
 * Always created as `pending` for staff to action (§6.9/§10.1: "creates a refund record" / "refunds queue (pending manual refunds with trx id entry)") — nothing here auto-disburses money.
 */
model Refund {
  id          String       @id @default(cuid(2))
  orderId     String       @map("order_id")
  paymentId   String?      @map("payment_id")
  returnId    String?      @map("return_id")
  amount      Int
  method      RefundMethod
  status      RefundStatus @default(pending)
  reason      String?
  approvedBy  String?      @map("approved_by")
  externalRef String?      @map("external_ref")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  return  Return?  @relation(fields: [returnId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

enum ReturnShippingPaidBy {
  customer
  brand
}

/**
 * Admin-managed, localized reasons list (§6.10) with a per-reason default on who pays return shipping.
 */
model ReturnReason {
  id            String               @id @default(cuid(2))
  code          String               @unique
  label         Json
  defaultPaidBy ReturnShippingPaidBy @default(customer) @map("default_paid_by")
  isActive      Boolean              @default(true) @map("is_active")
  position      Int                  @default(0)

  @@map("return_reasons")
}

enum ReturnType {
  refund
  exchange
  store_credit
}

enum ReturnStatus {
  requested
  approved
  rejected
  pickup_scheduled
  received
  inspected
  completed
  cancelled
}

model Return {
  id                   String                @id @default(cuid(2))
  orderId              String                @map("order_id")
  customerId           String?               @map("customer_id")
  type                 ReturnType
  status               ReturnStatus          @default(requested)
  reasonCode           String?               @map("reason_code")
  customerComment      String?               @map("customer_comment")
  mediaIds             String[]              @default([]) @map("media_ids")
  // [{ orderItemId, quantity, condition?: "pass"|"fail", restock?: boolean }]
  // — a point-in-time snapshot of what was requested/inspected, same
  // convention as `OrderDiscount.allocation`/`Cart` snapshots rather than a
  // join table.
  items                Json
  returnShippingPaidBy ReturnShippingPaidBy? @map("return_shipping_paid_by")
  resolution           Json?
  exchangeOrderId      String?               @map("exchange_order_id")
  rejectedReason       String?               @map("rejected_reason")
  approvedBy           String?               @map("approved_by")
  approvedAt           DateTime?             @map("approved_at")
  receivedAt           DateTime?             @map("received_at")
  completedAt          DateTime?             @map("completed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  refunds  Refund[]

  @@index([orderId])
  @@index([status])
  @@map("returns")
}

/**
 * Just a number + timestamp (§5.6) — the PDF itself is rendered on demand by the admin app's print view (browser print-to-PDF), never stored; this only guarantees the number stays stable across re-prints.
 */
model Invoice {
  id          String   @id @default(cuid(2))
  orderId     String   @unique @map("order_id")
  number      String   @unique
  generatedAt DateTime @default(now()) @map("generated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

/**
 * §10.2 "area mapping tool in admin" — maps our division/district/area to a specific courier provider instance's own location codes (Pathao city/zone/area, RedX area id, …) so booking a parcel doesn't need the staff member to remember codes.
 */
model CourierAreaMapping {
  id                        String   @id @default(cuid(2))
  courierProviderInstanceId String   @map("courier_provider_instance_id")
  divisionId                String   @map("division_id")
  districtId                String   @map("district_id")
  areaId                    String?  @map("area_id")
  courierAreaCode           String   @map("courier_area_code")
  courierAreaName           String?  @map("courier_area_name")
  extra                     Json?
  createdAt                 DateTime @default(now()) @map("created_at")

  @@unique([courierProviderInstanceId, divisionId, districtId, areaId])
  @@map("courier_area_mappings")
}

// ---------------------------------------------------------------------------
// Milestone 10 (docs/PROJECT_SPEC.md §16 M10) — conversion features. Q&A
// (`ProductQuestion`) already shipped in M8; the self-service exchange
// portal's guest gap and audience-targeted blocks reuse `Return`/`Segment`
// (M6/M8) with no schema change; "lookbook" is a block type
// (`@clothing/blocks`'s `lookbook`), not a model of its own.
// ---------------------------------------------------------------------------

/**
 * §16 M10 "size recommender + customer measurements" — one profile per
 * customer (not per order/session), reused across every product's
 * recommender call. `unit` only affects how the form was filled in; values
 * are always stored in cm/kg so `packages/shared/src/catalog/
 * size-recommender.ts` never has to convert at read time.
 */
model CustomerMeasurement {
  id           String     @id @default(cuid(2))
  customerId   String     @unique @map("customer_id")
  unit         LengthUnit @default(cm)
  heightCm     Float?     @map("height_cm")
  weightKg     Float?     @map("weight_kg")
  chestCm      Float?     @map("chest_cm")
  waistCm      Float?     @map("waist_cm")
  hipCm        Float?     @map("hip_cm")
  inseamCm     Float?     @map("inseam_cm")
  preferredFit String     @default("regular") @map("preferred_fit")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_measurements")
}

enum BundleDiscountType {
  none
  percent
  fixed_price
}

/**
 * §16 M10 "shop-the-look bundles" — names a bundle `Product`'s (productType
 * `bundle`) real, sellable component variants. The bundle product is never
 * itself orderable; `componentVariant` is an exact pick (e.g. "the red,
 * size M" top), not "any variant of this product", matching a styled photo.
 * `CartPricingService` applies the parent's `bundleDiscountType`/`Value`
 * live whenever a cart holds the full required set, whether added via the
 * PDP's one-click "add the look" or line by line.
 */
model BundleItem {
  id                 String @id @default(cuid(2))
  bundleProductId    String @map("bundle_product_id")
  componentProductId String @map("component_product_id")
  componentVariantId String @map("component_variant_id")
  quantity           Int    @default(1)
  position           Int    @default(0)

  bundleProduct    Product        @relation("BundleItems", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentProduct Product        @relation("BundleComponentOf", fields: [componentProductId], references: [id], onDelete: Cascade)
  componentVariant ProductVariant @relation(fields: [componentVariantId], references: [id], onDelete: Cascade)

  @@index([bundleProductId])
  @@index([componentVariantId])
  @@map("bundle_items")
}

/**
 * §16 M10 "storefront PWA + web push". Deliberately outside the generic
 * provider-instance framework (golden rule 2 is about *swappable vendors*;
 * Web Push is a W3C standard addressed straight at the browser's own push
 * service via our site's VAPID keypair — there's no alternative "driver" to
 * select, same reasoning already applied to the SSRF guard/JWT secret — see
 * docs/DECISIONS.md). `customerId` is nullable: a guest who never logs in
 * can still install the PWA and opt into push.
 */
model PushSubscription {
  id          String    @id @default(cuid(2))
  customerId  String?   @map("customer_id")
  // §16 M11 admin PWA — a subscription belongs to a customer OR a staff user.
  staffUserId String?   @map("staff_user_id")
  endpoint    String    @unique
  p256dh      String
  auth        String
  userAgent   String?   @map("user_agent")
  locale      String    @default("bn")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSentAt  DateTime? @map("last_sent_at")

  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([staffUserId])
  @@map("push_subscriptions")
}

/**
 * §16 M10 "blog/lookbook". Reuses the exact `blocksDraft`/`blocksPublished`
 * two-column draft/publish shape `Page` established in M3 (§9.2) — a
 * "lookbook" post is simply one built from the new `lookbook` hotspot block
 * plus `image_text`/`product_grid`, not a separate content model.
 */
model BlogPost {
  id              String     @id @default(cuid(2))
  title           Json
  slug            String     @unique
  excerpt         Json?
  coverMediaId    String?    @map("cover_media_id")
  blocksDraft     Json       @map("blocks_draft")
  blocksPublished Json?      @map("blocks_published")
  tags            String[]   @default([])
  status          PageStatus @default(draft)
  publishedAt     DateTime?  @map("published_at")
  seoTitle        Json?      @map("seo_title")
  seoDescription  Json?      @map("seo_description")
  authorStaffId   String?    @map("author_staff_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  @@index([status])
  @@map("blog_posts")
}

// ---------------------------------------------------------------------------
// Milestone 11 (docs/PROJECT_SPEC.md §16 M11) — order operations automation.
// ---------------------------------------------------------------------------

enum AutomationRunStatus {
  matched
  skipped
  failed
}

/**
 * §5.10 `automation_rules` — trigger → conditions → actions, all editable in admin.
 */
model AutomationRule {
  id             String   @id @default(cuid(2))
  name           String
  trigger        String
  conditions     Json     @default("{\"match\":\"all\",\"rules\":[]}")
  actions        Json     @default("[]")
  stopProcessing Boolean  @default(false) @map("stop_processing")
  priority       Int      @default(100)
  isActive       Boolean  @default(true) @map("is_active")
  runCount       Int      @default(0) @map("run_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  runs AutomationRun[]

  @@index([trigger, isActive])
  @@map("automation_rules")
}

model AutomationRun {
  id        String              @id @default(cuid(2))
  ruleId    String              @map("rule_id")
  trigger   String
  entityId  String?             @map("entity_id")
  payload   Json
  status    AutomationRunStatus
  result    Json?
  error     String?
  createdAt DateTime            @default(now()) @map("created_at")

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
  @@index([entityId])
  @@map("automation_runs")
}

/**
 * §16 M11 "auto courier assignment rules" — first matching active rule (by priority) picks the courier provider instance for a booking.
 */
model CourierAssignmentRule {
  id                        String   @id @default(cuid(2))
  name                      String
  priority                  Int      @default(100)
  conditions                Json     @default("{\"match\":\"all\",\"rules\":[]}")
  courierProviderInstanceId String   @map("courier_provider_instance_id")
  isActive                  Boolean  @default(true) @map("is_active")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@index([isActive, priority])
  @@map("courier_assignment_rules")
}

enum ApprovalStatus {
  pending
  approved
  rejected
  failed
}

/**
 * §5.10 `approval_requests` — a gated action is stored here instead of executing; an approver with `approvals.decide` replays it.
 */
model ApprovalRequest {
  id           String         @id @default(cuid(2))
  type         String
  entityType   String         @map("entity_type")
  entityId     String         @map("entity_id")
  summary      String
  payload      Json
  requestedBy  String         @map("requested_by")
  status       ApprovalStatus @default(pending)
  decidedBy    String?        @map("decided_by")
  decidedAt    DateTime?      @map("decided_at")
  decisionNote String?        @map("decision_note")
  error        String?
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------
// Milestone 12 (docs/PROJECT_SPEC.md §16 M12) — procurement, stock
// operations, finance reconciliation, scheduled reports, anomaly alerts and
// custom dashboards. Money is poisha throughout (golden rule 3).
// ---------------------------------------------------------------------------

/**
 * §5.4 `suppliers` — fabric mills, garment factories, wholesalers.
 */
model Supplier {
  id          String   @id @default(cuid(2))
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

enum PurchaseOrderType {
  purchase
  production
}

enum PurchaseOrderStatus {
  draft
  sent
  partially_received
  received
  cancelled
}

/**
 * §5.4 `purchase_orders` — a purchase from a supplier or a production run at a factory; receiving adds stock at `locationId`.
 */
model PurchaseOrder {
  id          String              @id @default(cuid(2))
  number      String              @unique
  supplierId  String              @map("supplier_id")
  type        PurchaseOrderType   @default(purchase)
  status      PurchaseOrderStatus @default(draft)
  // Where received goods are stocked.
  locationId  String              @map("location_id")
  expectedAt  DateTime?           @map("expected_at")
  notes       String?
  // Sum of qtyOrdered x unitCost, recomputed server-side on every item change.
  totalCost   Int                 @default(0) @map("total_cost")
  createdBy   String?             @map("created_by")
  sentAt      DateTime?           @map("sent_at")
  receivedAt  DateTime?           @map("received_at")
  cancelledAt DateTime?           @map("cancelled_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location StockLocation       @relation(fields: [locationId], references: [id])
  items    PurchaseOrderItem[]

  @@index([status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid(2))
  purchaseOrderId String @map("purchase_order_id")
  variantId       String @map("variant_id")
  qtyOrdered      Int    @map("qty_ordered")
  qtyReceived     Int    @default(0) @map("qty_received")
  unitCost        Int    @map("unit_cost")

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, variantId])
  @@map("purchase_order_items")
}

enum StockTransferStatus {
  draft
  in_transit
  received
  cancelled
}

/**
 * §5.4 `stock_transfers` — dispatch decrements the source (`transfer_out`), receipt increments the destination (`transfer_in`); stock in transit is sellable at neither location.
 */
model StockTransfer {
  id             String              @id @default(cuid(2))
  number         String              @unique
  fromLocationId String              @map("from_location_id")
  toLocationId   String              @map("to_location_id")
  status         StockTransferStatus @default(draft)
  note           String?
  createdBy      String?             @map("created_by")
  shippedAt      DateTime?           @map("shipped_at")
  receivedAt     DateTime?           @map("received_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  fromLocation StockLocation       @relation("StockTransferFrom", fields: [fromLocationId], references: [id])
  toLocation   StockLocation       @relation("StockTransferTo", fields: [toLocationId], references: [id])
  items        StockTransferItem[]

  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String @id @default(cuid(2))
  transferId       String @map("transfer_id")
  variantId        String @map("variant_id")
  quantity         Int
  quantityReceived Int    @default(0) @map("quantity_received")

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([transferId, variantId])
  @@map("stock_transfer_items")
}

enum StockTakeStatus {
  counting
  applied
  cancelled
}

/**
 * §5.4 `stock_takes` — `expectedQty` is the on-hand snapshot when counting started; applying adds (counted - expected) so sales made during the count are not wiped out.
 */
model StockTake {
  id         String          @id @default(cuid(2))
  number     String          @unique
  locationId String          @map("location_id")
  status     StockTakeStatus @default(counting)
  note       String?
  createdBy  String?         @map("created_by")
  appliedBy  String?         @map("applied_by")
  appliedAt  DateTime?       @map("applied_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  location StockLocation   @relation(fields: [locationId], references: [id])
  lines    StockTakeLine[]

  @@index([status])
  @@map("stock_takes")
}

model StockTakeLine {
  id          String    @id @default(cuid(2))
  stockTakeId String    @map("stock_take_id")
  variantId   String    @map("variant_id")
  expectedQty Int       @map("expected_qty")
  countedQty  Int?      @map("counted_qty")
  countedAt   DateTime? @map("counted_at")

  stockTake StockTake      @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([stockTakeId, variantId])
  @@map("stock_take_lines")
}

enum CodSettlementStatus {
  draft
  confirmed
}

/**
 * §10.6 `cod_settlements` — one courier payout (imported from the courier settlement file or fetched from its API); lines are auto-matched to shipments by consignment id.
 */
model CodSettlement {
  id                        String              @id @default(cuid(2))
  courierProviderInstanceId String?             @map("courier_provider_instance_id")
  courierDriver             String              @map("courier_driver")
  settlementRef             String?             @map("settlement_ref")
  periodFrom                DateTime?           @map("period_from")
  periodTo                  DateTime?           @map("period_to")
  // "file" | "api" | "manual"
  source                    String
  fileName                  String?             @map("file_name")
  totalCollected            Int                 @default(0) @map("total_collected")
  totalCharges              Int                 @default(0) @map("total_charges")
  netAmount                 Int                 @default(0) @map("net_amount")
  // What actually landed in the bank, staff-entered on confirm.
  receivedAmount            Int?                @map("received_amount")
  receivedAt                DateTime?           @map("received_at")
  status                    CodSettlementStatus @default(draft)
  note                      String?
  createdBy                 String?             @map("created_by")
  confirmedBy               String?             @map("confirmed_by")
  confirmedAt               DateTime?           @map("confirmed_at")
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  lines CodSettlementLine[]

  @@unique([courierDriver, settlementRef])
  @@index([status])
  @@map("cod_settlements")
}

model CodSettlementLine {
  id            String  @id @default(cuid(2))
  settlementId  String  @map("settlement_id")
  shipmentId    String? @map("shipment_id")
  consignmentId String  @map("consignment_id")
  collected     Int
  charge        Int     @default(0)
  // What we expected the courier to collect (shipment COD amount, or the
  // door delivery fee on a rejection); null when unmatched.
  expected      Int?
  matched       Boolean @default(false)
  // collected - expected (0 when unmatched).
  variance      Int     @default(0)
  // unmatched | variance | duplicate | already_settled | not_delivered
  flag          String?
  note          String?

  settlement CodSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  shipment   Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([settlementId])
  @@index([shipmentId])
  @@index([consignmentId])
  @@map("cod_settlement_lines")
}

/**
 * §10.6 `gateway_settlements` — an online payment provider payout; `expectedGross` is what our own succeeded payments for the period add up to, snapshotted when saved.
 */
model GatewaySettlement {
  id                 String        @id @default(cuid(2))
  providerInstanceId String?       @map("provider_instance_id")
  method             PaymentMethod
  settlementRef      String?       @map("settlement_ref")
  periodFrom         DateTime      @map("period_from")
  periodTo           DateTime      @map("period_to")
  gross              Int
  fees               Int
  net                Int
  expectedGross      Int           @default(0) @map("expected_gross")
  receivedAt         DateTime?     @map("received_at")
  note               String?
  createdBy          String?       @map("created_by")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@unique([method, settlementRef])
  @@index([periodFrom, periodTo])
  @@map("gateway_settlements")
}

enum ReportFrequency {
  daily
  weekly
  monthly
}

/**
 * §8.2 "Scheduled email reports (phase 2)" — a report key from the reports catalog, emailed as an HTML table on a cadence.
 */
model ScheduledReport {
  id         String          @id @default(cuid(2))
  name       String
  reportKey  String          @map("report_key")
  frequency  ReportFrequency
  recipients String[]
  locale     String          @default("bn")
  isActive   Boolean         @default(true) @map("is_active")
  nextRunAt  DateTime        @map("next_run_at")
  lastSentAt DateTime?       @map("last_sent_at")
  lastError  String?         @map("last_error")
  createdBy  String?         @map("created_by")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([isActive, nextRunAt])
  @@map("scheduled_reports")
}

enum AnomalySeverity {
  warning
  critical
}

/**
 * §8.2 dashboard "alerts (anomalies ...)" — one row per detected deviation; `dedupeKey` (metric + day) stops the same anomaly re-alerting on every sweep.
 */
model AnomalyAlert {
  id             String          @id @default(cuid(2))
  metric         String
  severity       AnomalySeverity
  observed       Float
  expected       Float
  message        Json
  dedupeKey      String          @unique @map("dedupe_key")
  acknowledgedBy String?         @map("acknowledged_by")
  acknowledgedAt DateTime?       @map("acknowledged_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([acknowledgedAt, createdAt])
  @@map("anomaly_alerts")
}

/**
 * §8.2 "Customizable widgets per role (phase 2)" — scope "staff" (scopeId = staff id), "role" (scopeId = role id) or "default" (scopeId = "default"); the most specific one wins.
 */
model DashboardLayout {
  id        String   @id @default(cuid(2))
  scope     String
  scopeId   String   @map("scope_id")
  widgets   Json
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scope, scopeId])
  @@map("dashboard_layouts")
}

