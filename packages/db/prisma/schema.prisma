// Prisma schema — Fashion Commerce Platform.
// Conventions (docs/PROJECT_SPEC.md §5): tables snake_case plural; id cuid2 string;
// created_at/updated_at on every table; soft delete (deleted_at) on catalog, CMS,
// customers, staff; money fields are Int poisha; LocalizedText is JSONB (modeled
// here as `Json`, shape `{ bn?: string; en?: string }` — see packages/shared/src/i18n).
//
// Milestone 1 scope (docs/PROJECT_SPEC.md §16 M1): system/staff, settings,
// ui_strings, locations, media, audit. Catalog/inventory/customers/orders/CMS
// etc. are designed together with their own milestones (M2+) rather than
// bolted on here — see docs/DECISIONS.md "Milestone 0 scope boundary" for the
// same reasoning applied again at M1.
//
// Deferred from the full §5.1 "System and staff" table list — not needed to
// satisfy M1's acceptance criteria, added when the milestone that needs them
// arrives (recorded in docs/DECISIONS.md): approval_requests, notifications_admin,
// saved_views, api_keys, outbound_webhooks (+ deliveries), webhook_events,
// courier_area_mappings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Settings, UI strings
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model UiString {
  key       String   @id
  bn        String
  en        String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ui_strings")
}

// ---------------------------------------------------------------------------
// Staff, roles, RBAC
// ---------------------------------------------------------------------------

enum StaffUserStatus {
  active
  disabled
}

model StaffUser {
  id            String          @id @default(cuid(2))
  name          String
  email         String          @unique @db.Citext
  passwordHash  String          @map("password_hash")
  totpSecret    String?         @map("totp_secret")
  totpEnabled   Boolean         @default(false) @map("totp_enabled")
  locale        String          @default("bn")
  avatarMediaId String?         @map("avatar_media_id")
  status        StaffUserStatus @default(active)
  lastLoginAt   DateTime?       @map("last_login_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  avatar   Media?         @relation(fields: [avatarMediaId], references: [id], onDelete: SetNull)
  sessions StaffSession[]
  roles    StaffRole[]

  @@map("staff_users")
  @@index([status])
  @@index([avatarMediaId])
}

model StaffSession {
  id          String    @id @default(cuid(2))
  staffUserId String    @map("staff_user_id")
  tokenHash   String    @unique @map("token_hash")
  ip          String?
  userAgent   String?   @map("user_agent")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@map("staff_sessions")
  @@index([staffUserId])
  @@index([expiresAt])
}

model Role {
  id          String   @id @default(cuid(2))
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  staff       StaffRole[]

  @@map("roles")
}

model RolePermission {
  id         String @id @default(cuid(2))
  roleId     String @map("role_id")
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("role_permissions")
  @@unique([roleId, permission])
  @@index([permission])
}

model StaffRole {
  id          String @id @default(cuid(2))
  staffUserId String @map("staff_user_id")
  roleId      String @map("role_id")

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("staff_roles")
  @@unique([staffUserId, roleId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

enum AuditActorType {
  staff
  system
  customer
  api_key
}

model AuditLog {
  id         String         @id @default(cuid(2))
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id")
  action     String
  entityType String         @map("entity_type")
  entityId   String?        @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?        @map("user_agent")
  createdAt  DateTime       @default(now()) @map("created_at")

  // Append-only: no updatedAt, no soft delete, no update/delete access from app code.

  @@map("audit_logs")
  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Provider framework
// ---------------------------------------------------------------------------

enum ProviderMode {
  sandbox
  live
}

model ProviderInstance {
  id         String       @id @default(cuid(2))
  capability String
  driver     String
  name       String
  enabled    Boolean      @default(false)
  mode       ProviderMode @default(sandbox)
  isDefault  Boolean      @default(false) @map("is_default")
  priority   Int          @default(0)
  // Encrypted at rest (AES-256-GCM, see packages/shared/src/crypto): the column
  // is JSONB, but its value is always `{ iv, tag, ciphertext }` (base64), never
  // plaintext config. See packages/shared/src/providers.
  config     Json
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  logs  ProviderLog[]
  media Media[]

  @@map("provider_instances")
  @@index([capability])
}

model ProviderLog {
  id                 String   @id @default(cuid(2))
  providerInstanceId String   @map("provider_instance_id")
  operation          String
  status             String
  durationMs         Int      @map("duration_ms")
  // Redacted by the provider wrapper before being written — never raw secrets.
  request            Json?
  response           Json?
  correlationId      String?  @map("correlation_id")
  createdAt          DateTime @default(now()) @map("created_at")

  providerInstance ProviderInstance @relation(fields: [providerInstanceId], references: [id], onDelete: Cascade)

  @@map("provider_logs")
  @@index([providerInstanceId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Queue / scheduler (admin-visible schedules; pg-boss owns its own tables)
// ---------------------------------------------------------------------------

enum ScheduledTaskStatus {
  pending
  running
  done
  failed
}

model ScheduledTask {
  id        String              @id @default(cuid(2))
  type      String
  payload   Json?
  runAt     DateTime            @map("run_at")
  status    ScheduledTaskStatus @default(pending)
  lastError String?             @map("last_error")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@map("scheduled_tasks")
  @@index([status, runAt])
}

// ---------------------------------------------------------------------------
// Locations (Bangladesh)
// ---------------------------------------------------------------------------

model Division {
  id   String @id @default(cuid(2))
  code String @unique
  name Json

  districts District[]

  @@map("divisions")
}

model District {
  id         String @id @default(cuid(2))
  divisionId String @map("division_id")
  code       String @unique
  name       Json

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  areas    Area[]

  @@map("districts")
  @@index([divisionId])
}

enum AreaType {
  upazila
  thana
  city_area
}

model Area {
  id          String   @id @default(cuid(2))
  districtId  String   @map("district_id")
  // Stable natural key for seed idempotency and courier area-mapping tools
  // (`<districtCode>-<slug(nameEn)>`), since `name` (LocalizedText JSONB)
  // can't itself be a unique/upsert key in Postgres via Prisma.
  code        String   @unique
  name        Json
  type        AreaType
  isDhakaCity Boolean  @default(false) @map("is_dhaka_city")
  postcode    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@map("areas")
  @@index([districtId])
  @@index([isDhakaCity])
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

model MediaFolder {
  id        String   @id @default(cuid(2))
  name      String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   MediaFolder?  @relation("MediaFolderParent", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("MediaFolderParent")
  media    Media[]

  @@map("media_folders")
  @@index([parentId])
}

enum MediaKind {
  image
  video
  document
  font
}

model Media {
  id            String    @id @default(cuid(2))
  folderId      String?   @map("folder_id")
  kind          MediaKind
  // "local" | "s3" | "cloudinary" (packages/shared provider driver key) —
  // which storage driver this file lives in, so it can be served/deleted/
  // regenerated correctly even if the active driver setting changes later
  // (docs/DECISIONS.md, Cloudinary change request 2026-10-22).
  storageDriver String    @map("storage_driver")
  storageKey    String    @map("storage_key")
  // Set only when storageDriver's config comes from `provider_instances`
  // (e.g. cloudinary), never for the env-configured default. Deleting that
  // instance is blocked while media rows reference it — see
  // ProviderInstancesController.
  providerInstanceId String? @map("provider_instance_id")
  // Cloudinary public_id (or any future provider's native id). Null for
  // local/s3, which only need storageKey.
  externalId    String?   @map("external_id")
  // Cloudinary resource_type vocabulary (image/video/raw), populated for
  // every asset regardless of provider so it's ready when an asset moves.
  resourceType  String    @default("image") @map("resource_type")
  // Cloudinary asset version, for cache-busting delivery URLs. Null otherwise.
  version       Int?
  originalName  String    @map("original_name")
  mimeType      String    @map("mime_type")
  sizeBytes     Int       @map("size_bytes")
  width         Int?
  height        Int?
  blurDataUrl   String?   @map("blur_data_url")
  focalX        Float?    @map("focal_x")
  focalY        Float?    @map("focal_y")
  // { thumb: { key, width, height }, md: {...}, lg: {...} } — generated
  // sizes. Null for cloudinary-backed assets, which size on the fly
  // (packages/shared/src/media/url.ts) instead of pre-generating.
  variants      Json?
  altText       Json?     @map("alt_text")
  uploadedBy    String?   @map("uploaded_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  folder           MediaFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  providerInstance ProviderInstance? @relation(fields: [providerInstanceId], references: [id], onDelete: SetNull)
  usages           MediaUsage[]
  staffAvatarOf    StaffUser[]
  productMedia     ProductMedia[]

  @@map("media")
  @@index([folderId])
  @@index([providerInstanceId])
  @@index([kind])
}

model MediaUsage {
  id         String   @id @default(cuid(2))
  mediaId    String   @map("media_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@map("media_usages")
  @@unique([mediaId, entityType, entityId])
  @@index([entityType, entityId])
}

enum MediaMigrationJobStatus {
  pending
  running
  done
  failed
  cancelled
}

// "Move media to provider X" (change request 2026-10-22, §7): a resumable,
// chunked background job — apps/api's MediaMigrationService processes a
// bounded batch per scheduler tick and advances `cursor`, so a restart
// continues instead of starting over. Super Admin only.
model MediaMigrationJob {
  id             String                  @id @default(cuid(2))
  // "env" or a provider_instances.id — same vocabulary as `media.defaultProvider`.
  toProvider     String                  @map("to_provider")
  dryRun         Boolean                 @default(false) @map("dry_run")
  status         MediaMigrationJobStatus @default(pending)
  totalCount     Int                     @default(0) @map("total_count")
  processedCount Int                     @default(0) @map("processed_count")
  failedCount    Int                     @default(0) @map("failed_count")
  // Last processed Media.id (ids sort chronologically — cuid2) — the resume point.
  cursor         String?
  lastError      String?                 @map("last_error")
  createdBy      String?                 @map("created_by")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  finishedAt     DateTime?               @map("finished_at")

  @@map("media_migration_jobs")
}

// ---------------------------------------------------------------------------
// Catalog (Milestone 2, docs/PROJECT_SPEC.md §5.3/§16 M2)
//
// Slugs are a single ASCII identifier shared by both locales, not localized
// per-locale paths — simplest option consistent with golden rule 1, and the
// storefront routing that would need per-locale slugs doesn't exist before
// M3/M4 anyway (docs/DECISIONS.md). `search_document` is modeled as
// Unsupported because Postgres generated columns require IMMUTABLE
// expressions and `to_tsvector` is STABLE — it's kept in sync by a trigger
// instead (see migration.sql), the standard Postgres full-text pattern.
// ---------------------------------------------------------------------------

enum AttributeType {
  select
  multiselect
  text
  number
  boolean
  color
}

model Attribute {
  id             String        @id @default(cuid(2))
  code           String        @unique
  name           Json
  type           AttributeType
  isFilterable   Boolean       @default(true) @map("is_filterable")
  isVisibleOnPdp Boolean       @default(true) @map("is_visible_on_pdp")
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  values               AttributeValue[]
  productAttributeValues ProductAttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String   @id @default(cuid(2))
  attributeId String   @map("attribute_id")
  value       Json
  slug        String
  colorHex    String?  @map("color_hex")
  imageMediaId String? @map("image_media_id")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  attribute              Attribute                @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productAttributeValues ProductAttributeValue[]

  @@map("attribute_values")
  @@unique([attributeId, slug])
}

enum SizeSystemType {
  letter
  numeric
  kids_age
  free_size
  custom
}

model SizeSystem {
  id        String         @id @default(cuid(2))
  name      Json
  type      SizeSystemType
  // Ordered [{ code, label: LocalizedText }] — kept as JSON since order matters
  // and Postgres scalar arrays can't hold structured values.
  values    Json
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  options ProductOption[]

  @@map("size_systems")
}

enum LengthUnit {
  inch
  cm
}

model SizeChart {
  id           String     @id @default(cuid(2))
  name         Json
  unitDefault  LengthUnit @default(cm) @map("unit_default")
  // [{ key, label: LocalizedText }]
  columns      Json
  // [{ size, measurements: { [columnKey]: number } }]
  rows         Json
  howToMeasure Json?      @map("how_to_measure")
  notes        Json?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  categories Category[]
  products   Product[]

  @@map("size_charts")
}

model Category {
  id            String    @id @default(cuid(2))
  parentId      String?   @map("parent_id")
  name          Json
  slug          String    @unique
  description   Json?
  imageMediaId  String?   @map("image_media_id")
  bannerMediaId String?   @map("banner_media_id")
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  seoTitle      Json?     @map("seo_title")
  seoDescription Json?    @map("seo_description")
  sizeChartId   String?   @map("size_chart_id")
  // Attribute ids that apply to products in this category — drives which
  // attribute inputs the product editor shows, not a hard constraint.
  attributeIds  String[]  @default([]) @map("attribute_ids")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  parent          Category?         @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]        @relation("CategoryParent")
  sizeChart       SizeChart?        @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  products        Product[]
  productCategories ProductCategory[]

  @@map("categories")
  @@index([parentId])
  @@index([sizeChartId])
}

enum ProductStatus {
  draft
  active
  archived
  scheduled
}

enum ProductType {
  standard
  bundle
  gift_card
  preorder
}

model Product {
  id                   String        @id @default(cuid(2))
  title                Json
  slug                 String        @unique
  subtitle             Json?
  description          Json?
  shortDescription     Json?         @map("short_description")
  categoryId           String?       @map("category_id")
  brandLabel           Json?         @map("brand_label")
  tags                 String[]      @default([])
  status               ProductStatus @default(draft)
  publishedAt          DateTime?     @map("published_at")
  unpublishAt          DateTime?     @map("unpublish_at")
  productType          ProductType   @default(standard) @map("product_type")
  sizeChartId          String?       @map("size_chart_id")
  careInstructions     Json?         @map("care_instructions")
  fabric               Json?
  modelInfo            Json?         @map("model_info")
  videoUrl             String?       @map("video_url")
  seoTitle             Json?         @map("seo_title")
  seoDescription       Json?         @map("seo_description")
  isFeatured           Boolean       @default(false) @map("is_featured")
  sortWeight           Int           @default(0) @map("sort_weight")
  requiresShipping     Boolean       @default(true) @map("requires_shipping")
  weightGramsDefault   Int?          @map("weight_grams_default")
  hsCode               String?       @map("hs_code")
  ratingAvg            Float         @default(0) @map("rating_avg")
  ratingCount          Int           @default(0) @map("rating_count")
  salesCount           Int           @default(0) @map("sales_count")
  // Kept in sync by a Postgres trigger (migration.sql) — see note above.
  searchDocument       Unsupported("tsvector")? @map("search_document")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  deletedAt            DateTime?     @map("deleted_at")

  category               Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sizeChart              SizeChart?               @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  additionalCategories   ProductCategory[]
  attributeValues        ProductAttributeValue[]
  options                ProductOption[]
  variants               ProductVariant[]
  media                  ProductMedia[]
  relationsFrom          ProductRelation[]        @relation("ProductRelationFrom")
  relationsTo            ProductRelation[]        @relation("ProductRelationTo")
  versions               ProductVersion[]
  collectionProducts     CollectionProduct[]

  @@map("products")
  @@index([categoryId])
  @@index([sizeChartId])
  @@index([status])
}

model ProductCategory {
  id         String @id @default(cuid(2))
  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("product_categories")
  @@unique([productId, categoryId])
  @@index([categoryId])
}

model ProductAttributeValue {
  id               String   @id @default(cuid(2))
  productId        String   @map("product_id")
  attributeId      String   @map("attribute_id")
  attributeValueId String?  @map("attribute_value_id")
  valueText        String?  @map("value_text")
  valueNumber      Float?   @map("value_number")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@map("product_attribute_values")
  @@index([productId])
  @@index([attributeId])
  @@index([attributeValueId])
}

enum ProductOptionType {
  size
  color
  generic
}

model ProductOption {
  id           String            @id @default(cuid(2))
  productId    String            @map("product_id")
  name         Json
  type         ProductOptionType
  sizeSystemId String?           @map("size_system_id")
  position     Int               @default(0)

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeSystem SizeSystem?         @relation(fields: [sizeSystemId], references: [id], onDelete: SetNull)
  values     ProductOptionValue[]

  @@map("product_options")
  @@index([productId])
}

model ProductOptionValue {
  id              String  @id @default(cuid(2))
  productOptionId String  @map("product_option_id")
  value           Json
  colorHex        String? @map("color_hex")
  swatchImageMediaId String? @map("swatch_image_media_id")
  position        Int     @default(0)

  option    ProductOption  @relation(fields: [productOptionId], references: [id], onDelete: Cascade)
  productMedia ProductMedia[]

  @@map("product_option_values")
  @@index([productOptionId])
}

model ProductVariant {
  id             String   @id @default(cuid(2))
  productId      String   @map("product_id")
  sku            String   @unique
  barcode        String?  @unique
  // ProductOptionValue ids forming this combination — e.g. [sizeM, colorRed].
  optionValueIds String[] @default([]) @map("option_value_ids")
  // Poisha (golden rule 3).
  price          Int
  compareAtPrice Int?     @map("compare_at_price")
  // Permission-protected (catalog.cost.read) — filtered out of API responses
  // for staff without that permission, see ProductsController.
  costPrice      Int?     @map("cost_price")
  weightGrams    Int?     @map("weight_grams")
  isActive       Boolean  @default(true) @map("is_active")
  position       Int      @default(0)
  imageIds       String[] @default([]) @map("image_ids")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLevels InventoryLevel[]
  stockMovements  StockMovement[]

  @@map("product_variants")
  @@index([productId])
}

model ProductMedia {
  id            String  @id @default(cuid(2))
  productId     String  @map("product_id")
  mediaId       String  @map("media_id")
  optionValueId String? @map("option_value_id")
  position      Int     @default(0)
  alt           Json?

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  media        Media               @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  optionValue  ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  @@map("product_media")
  @@index([productId])
  @@index([mediaId])
  @@index([optionValueId])
}

enum ProductRelationType {
  similar
  complete_the_look
  upsell
  cross_sell
}

model ProductRelation {
  id              String              @id @default(cuid(2))
  productId       String              @map("product_id")
  relatedProductId String             @map("related_product_id")
  type            ProductRelationType
  position        Int                 @default(0)

  product        Product @relation("ProductRelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductRelationTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@map("product_relations")
  @@unique([productId, relatedProductId, type])
}

model ProductVersion {
  id        String   @id @default(cuid(2))
  productId String   @map("product_id")
  snapshot  Json
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_versions")
  @@index([productId])
}

enum CollectionType {
  manual
  automatic
}

model Collection {
  id             String         @id @default(cuid(2))
  name           Json
  slug           String         @unique
  description    Json?
  imageMediaId   String?        @map("image_media_id")
  bannerMediaId  String?        @map("banner_media_id")
  type           CollectionType @default(manual)
  // Automatic-type condition tree ({ all/any: [{ field, op, value }] }).
  rules          Json?
  sortMode       String         @default("manual") @map("sort_mode")
  isActive       Boolean        @default(true) @map("is_active")
  startsAt       DateTime?      @map("starts_at")
  endsAt         DateTime?      @map("ends_at")
  seoTitle       Json?          @map("seo_title")
  seoDescription Json?          @map("seo_description")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  collectionProducts CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  id           String   @id @default(cuid(2))
  collectionId String   @map("collection_id")
  productId    String   @map("product_id")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("collection_products")
  @@unique([collectionId, productId])
  @@index([productId])
}

enum PriceScheduleTargetType {
  variant
  product
  collection
  category
  tag
}

enum PriceScheduleStatus {
  scheduled
  active
  ended
  cancelled
}

model PriceSchedule {
  id            String                  @id @default(cuid(2))
  targetType    PriceScheduleTargetType @map("target_type")
  // Entity id for variant/product/collection/category targets, the literal
  // tag string for the "tag" target.
  targetId      String                  @map("target_id")
  newPrice      Int?                    @map("new_price")
  percentChange Float?                  @map("percent_change")
  startsAt      DateTime                @map("starts_at")
  endsAt        DateTime?               @map("ends_at")
  revertOnEnd   Boolean                 @default(true) @map("revert_on_end")
  status        PriceScheduleStatus     @default(scheduled)
  // { [variantId]: previousPriceInPoisha } — captured when the schedule is
  // applied, so it can be reverted exactly even if other schedules also
  // touched the same variant in between.
  appliedSnapshot Json?                 @map("applied_snapshot")
  createdBy     String?                 @map("created_by")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@map("price_schedules")
  @@index([status, startsAt])
  @@index([status, endsAt])
}

// ---------------------------------------------------------------------------
// Inventory (Milestone 2, docs/PROJECT_SPEC.md §5.4) — stock_locations,
// inventory_levels, stock_movements, low-stock thresholds only. Reservations,
// transfers, stock takes, suppliers and purchase orders are M5/M12.
// ---------------------------------------------------------------------------

model StockLocation {
  id             String   @id @default(cuid(2))
  name           String
  address        Json?
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  fulfillsOnline Boolean  @default(true) @map("fulfills_online")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  inventoryLevels InventoryLevel[]
  stockMovements  StockMovement[]

  @@map("stock_locations")
}

model InventoryLevel {
  id                String   @id @default(cuid(2))
  variantId         String   @map("variant_id")
  locationId        String   @map("location_id")
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0) @map("reserved")
  // Generated column (`on_hand - reserved`, see migration.sql) — never
  // written from application code, Prisma just reads it back.
  available         Int      @default(0)
  lowStockThreshold Int?     @map("low_stock_threshold")
  binLocation       String?  @map("bin_location")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("inventory_levels")
  @@unique([variantId, locationId])
  @@index([locationId])
}

enum StockMovementReason {
  sale
  cancel
  return_restock
  damage
  adjustment
  transfer_in
  transfer_out
  purchase_receive
  stock_take
}

model StockMovement {
  id            String              @id @default(cuid(2))
  variantId     String              @map("variant_id")
  locationId    String              @map("location_id")
  quantity      Int
  reason        StockMovementReason
  referenceType String?             @map("reference_type")
  referenceId   String?             @map("reference_id")
  note          String?
  actor         String?
  createdAt     DateTime            @default(now()) @map("created_at")

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Append-only (audit-log convention) — no updatedAt.

  @@map("stock_movements")
  @@index([variantId, locationId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Search (Milestone 2) — Postgres FTS + trigram, editable Banglish synonyms.
// ---------------------------------------------------------------------------

model SearchSynonym {
  id        String   @id @default(cuid(2))
  // Canonical term, e.g. "panjabi".
  term      String   @unique
  // Equivalent spellings/scripts that should also match it, e.g.
  // ["punjabi", "পাঞ্জাবি"] — editable in admin (docs/PROJECT_SPEC.md §16 M2).
  synonyms  String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("search_synonyms")
}

// ---------------------------------------------------------------------------
// Catalog import/export (Milestone 2) — resumable like MediaMigrationJob.
// The uploaded file and the generated error report are scratch data for the
// job's lifetime, not catalog content, so they're kept as a column here
// rather than going through the media library/provider framework.
// ---------------------------------------------------------------------------

enum CatalogImportJobStatus {
  pending
  running
  done
  failed
  cancelled
}

model CatalogImportJob {
  id             String                 @id @default(cuid(2))
  fileName       String                 @map("file_name")
  // Cleared (set null) once processing finishes — kept only long enough to
  // process in chunks across scheduler ticks.
  fileBytes      Bytes?                 @map("file_bytes")
  dryRun         Boolean                @default(false) @map("dry_run")
  status         CatalogImportJobStatus @default(pending)
  totalRows      Int                    @default(0) @map("total_rows")
  processedRows  Int                    @default(0) @map("processed_rows")
  createdRows    Int                    @default(0) @map("created_rows")
  updatedRows    Int                    @default(0) @map("updated_rows")
  errorRows      Int                    @default(0) @map("error_rows")
  // Resume cursor — row index into the parsed sheet, 0-based.
  cursor         Int                    @default(0)
  // CSV text: "row,sku,message" — downloadable from the admin UI.
  errorReport    String?                @map("error_report")
  createdBy      String?                @map("created_by")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  finishedAt     DateTime?              @map("finished_at")

  @@map("catalog_import_jobs")
}

// ---------------------------------------------------------------------------
// CMS (Milestone 3, docs/PROJECT_SPEC.md §9/§16 M3)
//
// Block instances are kept as an ordered JSON array on the page itself
// (`{ id, type, props, visibility?, schedule? }[]`), not normalized into
// their own table — nothing ever queries "all pages using block type X" at
// this milestone's scale, and the alternative (a polymorphic per-block-type
// props table) buys nothing here. `blocksDraft`/`blocksPublished` are two
// separate columns so "draft vs published" (§9.2) is just which column is
// read, instead of a status flag that a half-finished edit could flip early.
// ---------------------------------------------------------------------------

enum PageStatus {
  draft
  scheduled
  published
}

model Page {
  id              String     @id @default(cuid(2))
  slug            String     @unique
  title           String
  status          PageStatus @default(draft)
  publishAt       DateTime?  @map("publish_at")
  blocksDraft     Json       @map("blocks_draft")
  blocksPublished Json?      @map("blocks_published")
  seoTitle        Json?      @map("seo_title")
  seoDescription  Json?      @map("seo_description")
  ogImageMediaId  String?    @map("og_image_media_id")
  noindex         Boolean    @default(false)
  // Reserved pages (home, 404, 500, maintenance) — protected from deletion
  // and from a slug change that would break the routes that look them up.
  isSystem        Boolean    @default(false) @map("is_system")
  // Policy placeholders (§9.3): seeded with needsContent=true; cleared the
  // first time an editor publishes real content, drives the admin
  // "content needed before launch" checklist.
  needsContent    Boolean    @default(false) @map("needs_content")
  lockedBy        String?    @map("locked_by")
  lockedAt        DateTime?  @map("locked_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  versions PageVersion[]

  @@map("pages")
  @@index([status])
}

model PageVersion {
  id             String   @id @default(cuid(2))
  pageId         String   @map("page_id")
  blocks         Json
  seoTitle       Json?    @map("seo_title")
  seoDescription Json?    @map("seo_description")
  note           String?
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_versions")
  @@index([pageId])
}

model Menu {
  id        String   @id @default(cuid(2))
  // Stable key a layout slot looks up by, e.g. "header", "footer", "mobile".
  key       String   @unique
  name      String
  // Tree, depth <= 3 (§9.3): [{ id, label: LocalizedText, type: "category"
  // | "collection" | "product" | "page" | "url", targetId?, url?, children? }].
  items     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("menus")
}

model AnnouncementBar {
  id        String    @id @default(cuid(2))
  message   Json
  linkUrl   String?   @map("link_url")
  linkText  Json?     @map("link_text")
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  isActive  Boolean   @default(true) @map("is_active")
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("announcement_bars")
}

enum PopupTrigger {
  immediate
  delay
  exit_intent
}

model Popup {
  id           String       @id @default(cuid(2))
  name         String
  title        Json
  body         Json
  imageMediaId String?      @map("image_media_id")
  ctaText      Json?        @map("cta_text")
  ctaUrl       String?      @map("cta_url")
  trigger      PopupTrigger @default(delay)
  delaySeconds Int?         @map("delay_seconds")
  startsAt     DateTime?    @map("starts_at")
  endsAt       DateTime?    @map("ends_at")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("popups")
}

model Redirect {
  id         String   @id @default(cuid(2))
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  statusCode Int      @default(301) @map("status_code")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("redirects")
}

/** `newsletter_signup` block (docs/PROJECT_SPEC.md §9.1) — minimal capture; broadcast/segmentation is a marketing feature for a later milestone. */
model NewsletterSubscriber {
  id        String   @id @default(cuid(2))
  email     String   @unique
  locale    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}
