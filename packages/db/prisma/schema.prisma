// Prisma schema — Fashion Commerce Platform.
// Conventions (docs/PROJECT_SPEC.md §5): tables snake_case plural; id cuid2 string;
// created_at/updated_at on every table; soft delete (deleted_at) on catalog, CMS,
// customers, staff; money fields are Int poisha; LocalizedText is JSONB.
//
// This file intentionally has zero models in Milestone 0. The full domain model
// (system/staff, locations, catalog, inventory, customers, cart/checkout/orders,
// shipping/payment rules, promotions, CMS, automation/AI/analytics/finance/support)
// is designed and migrated in Milestone 1 onward — see docs/PROJECT_SPEC.md §5
// and docs/PROGRESS.md for current status.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}
