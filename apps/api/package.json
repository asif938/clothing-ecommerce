    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "fflate": "0.8.2",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "5.3.1",
    "pg-boss": "12.38.0",
